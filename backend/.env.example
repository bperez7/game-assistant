# Run uvicorn from backend/. Paths are relative to the working directory.
WALKTHROUGH_DATABASE_PATH=data/walkthrough.db
WALKTHROUGH_CORS_ORIGINS=["http://localhost:5173"]
# Set before exposing write endpoints beyond your local machine.
# WALKTHROUGH_ADMIN_KEY=replace-with-a-long-random-secret
# Approved walkthrough sites. Exact hostnames only; no wildcards.
WALKTHROUGH_ALLOWED_SOURCE_HOSTS=["ign.com","www.ign.com","gamefaqs.com","www.gamefaqs.com","gamefaqs.gamespot.com","neoseeker.com","www.neoseeker.com","faqs.neoseeker.com","powerpyx.com","www.powerpyx.com","strategywiki.org","www.strategywiki.org"]
# Optional: install Ollama and pull a model, then set its exact model name.
# WALKTHROUGH_OLLAMA_MODEL=your-installed-model
WALKTHROUGH_OLLAMA_URL=http://localhost:11434
